{
  "version": "2.0.0",
  "testName": "urgency_test_max_conversion",
  "description": "Maximum conversion variant with aggressive urgency signals",
  
  "stockIndicator": {
    "enabled": true,
    "mode": "static_decrement",
    "initialStock": 12,
    "minStock": 2,
    "decrementPerDay": 3,
    "text": "Only {count} left!",
    "lowStockThreshold": 8,
    "lowStockText": "⚠️ Almost sold out!"
  },
  
  "viewerCount": {
    "enabled": true,
    "mode": "static",
    "staticValue": 14,
    "text": "{count} viewing now"
  },
  
  "sellingFast": {
    "enabled": true,
    "text": "🔥 47+ sold in last hour",
    "showAfterSeconds": 0
  },
  
  "demandIndicator": {
    "enabled": true,
    "text": "Trending #1",
    "showPercentage": true,
    "percentage": 94
  },
  
  "scarcityBar": {
    "enabled": true,
    "percentage": 18,
    "text": "Only {percentage}% left today",
    "color": "#DC2626"
  },
  
  "morningPuffiness": {
    "enabled": true,
    "headline": "Wake Up Without Puffiness",
    "subtext": "Our ergonomic design elevates your head just enough to prevent morning face swelling"
  },
  
  "ctaEnhancements": {
    "enabled": true,
    "primaryText": "Claim Your Pillow + FREE Gift",
    "urgencySubtext": "⚡ Offer expires at midnight",
    "pulseAnimation": true
  },
  
  "socialProof": {
    "enabled": true,
    "showRecentPurchases": true,
    "recentPurchaseText": "🎉 Someone in {city} just ordered!",
    "cities": ["New York", "Los Angeles", "London", "Sydney", "Toronto", "Berlin", "Chicago", "Miami", "Seattle", "Austin"],
    "intervalSeconds": 25
  },
  
  "deliveryPromise": {
    "enabled": true,
    "text": "Order now → Ships today, arrives in 2-4 days"
  },
  
  "mobile": {
    "collapseSecondaryElements": false,
    "collapseThresholdPx": 640,
    "hideViewerCount": false,
    "hideMicroBanners": false,
    "keepCtaAboveFold": true
  },
  
  "urgencyColor": "#DC2626",
  "accentColor": "#EA580C"
}

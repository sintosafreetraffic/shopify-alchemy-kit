# Hashed static assets - cache for 1 year (immutable)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Public images - cache for 1 year  
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Public videos - cache for 1 year
/videos/*
  Cache-Control: public, max-age=31536000, immutable

# Vite hashed JS bundles - cache for 1 year
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

# Vite hashed CSS bundles - cache for 1 year
/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# Fonts - cache for 1 year
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.woff
  Cache-Control: public, max-age=31536000, immutable

# HTML documents - no cache to ensure fresh content
/*
  Cache-Control: public, max-age=0, must-revalidate

# Override for index.html specifically
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Favicon - cache for 1 week
/favicon.png
  Cache-Control: public, max-age=604800

# Robots.txt - cache for 1 day
/robots.txt
  Cache-Control: public, max-age=86400
